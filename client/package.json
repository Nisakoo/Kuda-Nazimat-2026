{
  "name": "educational-world-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:imports": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "socket.io-client": "4.8.4",
    "svelte": "5.57.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "dependency-cruiser": "17.4.3",
    "happy-dom": "21.0.4",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
