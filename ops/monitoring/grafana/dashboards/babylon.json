{
  "uid": "babylon-server",
  "title": "Вавилон — сервер",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Шаг симуляции и рассылка, мс",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(game_tick_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "шаг p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(game_broadcast_interval_ms_bucket[1m])) by (le))",
          "legendFormat": "рассылка p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Игроки и соединения",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(game_players) by (state)",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "realtime_connections",
          "legendFormat": "соединения"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "NPC: очередь и исходы",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(npc_queue) by (state)",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(npc_requests_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}/с"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "NPC: время до первого текста и генерация, мс",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(npc_first_partial_ms_bucket[1m])) by (le))",
          "legendFormat": "первый текст p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(npc_generation_ms_bucket[1m])) by (le))",
          "legendFormat": "генерация p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP: запросы по маршруту",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(http_rate_limited_total[1m]))",
          "legendFormat": "429/с"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Вход: исходы и отзывы",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(auth_attempts_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(auth_sessions_revoked_total[5m])) by (reason)",
          "legendFormat": "отзыв {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Пакеты и ошибки протокола",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(realtime_packets_in_total[1m])) by (type)",
          "legendFormat": "вход {{type}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "sum(rate(realtime_invalid_packets_total[1m]))",
          "legendFormat": "неверные"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "БД и процесс",
      "datasource": {
        "type": "prometheus",
        "uid": "babylon-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(db_operation_ms_bucket[1m])) by (le))",
          "legendFormat": "БД p95, мс"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "process_resident_memory_bytes/1048576",
          "legendFormat": "RSS, МБ"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "babylon-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(process_event_loop_delay_ms_bucket[1m])) by (le))",
          "legendFormat": "event loop p99, мс"
        }
      ]
    }
  ]
}
